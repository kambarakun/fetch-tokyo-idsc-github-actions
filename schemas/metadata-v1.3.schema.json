{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kambarakun/fetch-tokyo-idsc-github-actions/schemas/metadata-v1.3.schema.json",
  "title": "Tokyo IDSC Metadata Schema (v1.3.0)",
  "description": "Common metadata schema (v1.3.0) for Tokyo Infectious Disease Surveillance Center data files. The authoritative schema version is 1.3.0 (see src/models/metadata.py::METADATA_VERSION). Validated against real metadata in CI via scripts/validate_metadata_schema.py.",
  "type": "object",
  "required": [
    "metadata_version",
    "name",
    "filename",
    "path",
    "profile",
    "data_type",
    "temporal",
    "bytes",
    "hash",
    "encoding",
    "created",
    "modified"
  ],
  "properties": {
    "metadata_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the metadata schema"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "URL-safe identifier (lowercase, alphanumeric, underscore only)"
    },
    "filename": {
      "type": "string",
      "description": "Original filename with extension"
    },
    "path": {
      "type": "string",
      "description": "Relative path from data directory"
    },
    "profile": {
      "type": "string",
      "enum": ["tokyo-idsc-raw", "tokyo-idsc-processed"],
      "description": "Metadata profile type"
    },
    "data_type": {
      "type": "string",
      "description": "Data type identifier (e.g., sentinel_weekly_age, notifiable_weekly)"
    },
    "temporal": {
      "type": "object",
      "required": ["year", "period", "period_type"],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100,
          "description": "Year of the data"
        },
        "period": {
          "type": "integer",
          "minimum": 1,
          "maximum": 53,
          "description": "Period number (week 1-53 or month 1-12)"
        },
        "period_type": {
          "type": "string",
          "enum": ["weekly", "monthly"],
          "description": "Type of period"
        }
      },
      "additionalProperties": false
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "File size in bytes"
    },
    "lines": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Number of lines in the file"
    },
    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512", "md5"],
          "description": "Hash algorithm used"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]+$",
          "description": "Hexadecimal hash value"
        }
      },
      "additionalProperties": false
    },
    "encoding": {
      "type": "string",
      "enum": ["shift_jis", "utf-8"],
      "description": "Character encoding of the file"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp in ISO 8601 format with timezone"
    },
    "modified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp in ISO 8601 format with timezone"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "path"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Source title or name"
          },
          "path": {
            "type": "string",
            "format": "uri",
            "description": "Source URL or path"
          }
        },
        "additionalProperties": false
      },
      "description": "Data provenance information"
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "failed", "pending"],
          "description": "Verification status"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time",
          "description": "Verification timestamp"
        },
        "method": {
          "type": "string",
          "enum": ["automated", "manual"],
          "description": "Verification method"
        },
        "checks": {
          "type": "object",
          "properties": {
            "file_size": { "type": "boolean" },
            "encoding": { "type": "boolean" },
            "csv_format": { "type": "boolean" },
            "path_safety": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of error messages"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of warning messages"
        },
        "details": {
          "type": "object",
          "description": "Structured detail information (v1.3.0+). Concrete values backing warning messages.",
          "properties": {
            "column_counts": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 },
              "description": "Observed CSV column counts (recorded on inconsistent column count)"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "description": "Data quality validation result (v1.2.0+)",
      "required": ["validation_timestamp", "validation_status", "issues"],
      "properties": {
        "validation_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Quality validation timestamp in ISO 8601 format"
        },
        "validation_status": {
          "type": "string",
          "enum": ["completed", "skipped", "failed"],
          "description": "Overall status of the quality validation process"
        },
        "issues": {
          "type": "array",
          "description": "List of issues found during validation (empty array means no issues)",
          "items": {
            "type": "object",
            "required": ["check_type", "validation_status", "message", "details"],
            "properties": {
              "check_type": {
                "type": "string",
                "description": "Identifier of the quality check (e.g., gender_sum_consistency)"
              },
              "validation_status": {
                "type": "string",
                "enum": ["completed", "skipped", "failed"],
                "description": "Status of this individual check"
              },
              "message": {
                "type": "string",
                "description": "Human-readable description of the issue"
              },
              "details": {
                "type": "object",
                "description": "Structured detail information for the issue",
                "properties": {
                  "source_file": {
                    "type": "string",
                    "description": "Source file the issue was detected in"
                  },
                  "affected_count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of records affected by the issue"
                  },
                  "truncated": {
                    "type": "boolean",
                    "description": "Whether affected_locations was truncated (exceeded the cap)"
                  },
                  "affected_locations": {
                    "type": "array",
                    "description": "Detailed list of affected locations (capped, e.g. at 10 entries)",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "_fetch": {
      "type": "object",
      "description": "Private properties for fetched (raw) data",
      "properties": {
        "source_url": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "URL from which data was fetched"
        },
        "fetch_time_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Time taken to fetch the data in seconds"
        },
        "force_overwrite": {
          "type": "boolean",
          "description": "Whether force overwrite was enabled"
        },
        "save_all_zero": {
          "type": "boolean",
          "description": "Whether all-zero data saving was enabled"
        }
      },
      "additionalProperties": false
    },
    "_process": {
      "type": "object",
      "description": "Private properties for processed data",
      "properties": {
        "source_name": {
          "type": "string",
          "description": "Name of the source raw file (without extension)"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]+$",
          "description": "Hash of the source file for traceability"
        },
        "processing_time_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Time taken to process the data in seconds"
        },
        "gender": {
          "type": ["string", "null"],
          "enum": ["male", "female", "total", null],
          "description": "Gender category for sentinel data (null if not applicable)"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile": { "const": "tokyo-idsc-raw" } }
      },
      "then": {
        "required": ["_fetch"],
        "properties": {
          "_process": false
        }
      }
    },
    {
      "if": {
        "properties": { "profile": { "const": "tokyo-idsc-processed" } }
      },
      "then": {
        "required": ["_process"],
        "properties": {
          "_fetch": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "temporal": {
            "properties": { "period_type": { "const": "monthly" } }
          }
        }
      },
      "then": {
        "properties": {
          "temporal": {
            "properties": {
              "period": { "maximum": 12 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
